# Режим работы (development / production)
NODE_ENV=development

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_token_here

# Flightradar24 API
# Для Sandbox: https://flightradar24.com
# Для Production: https://flightradar24.com
FR24_API_BASE_URL=https://fr24api.flightradar24.com/api
FR24_API_TOKEN=your_fr24_sandbox_token_here

# Настройки для docker-compose.prod.yml на VPS (в нижнем регистре)
GITHUB_REPOSITORY_OWNER=your_github_username
REPO_NAME=your_repo_name
